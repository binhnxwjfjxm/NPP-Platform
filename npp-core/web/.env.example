NODE_ENV=development
HOST=127.0.0.1
PORT=3003
NEXT_PUBLIC_CORE_API_URL=http://127.0.0.1:3004
NEXT_PUBLIC_APP_NAME=NPP Core

# Server-side Basic Auth for protected Core web routes. Use real secrets only in provider configuration.
CORE_WEB_ADMIN_USERNAME=<admin-username>
CORE_WEB_ADMIN_PASSWORD=<admin-password>

# Server-side only. Never use NEXT_PUBLIC_ for these values.
CORE_API_INTERNAL_URL=http://127.0.0.1:3004
CORE_API_SERVER_TOKEN=<server-only-token>

# Internal verification surfaces are disabled by default.
FOUNDATION_TEST_UI_ENABLED=false
FOUNDATION_R2_TEST_ENABLED=false

# E2E-only variables. Use an isolated local/CI PostgreSQL and test-only token.
E2E_DATABASE_URL=postgresql://<test-user>:<test-password>@127.0.0.1:5432/<test-database>
E2E_BACKEND_API_TOKEN=<test-only-token>
