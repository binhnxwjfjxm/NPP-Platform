NODE_ENV=development
HOST=127.0.0.1
PORT=3004
INSTALLATION_ID=npp-local
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/npp_platform
DATABASE_SSL_MODE=disable
BACKEND_API_TOKEN=replace-with-local-token
CORE_BOOTSTRAP_ACTOR_ID=bootstrap:core-api
# Dedicated token accepted only for MCP customer-onboarding submit/read calls.
MCP_ONBOARDING_API_TOKEN=replace-with-distinct-server-only-token
MCP_ONBOARDING_ACTOR_ID=service:mcp-customer-onboarding
# Dedicated token accepted only for Công Ty Sales read/create from MCP.
MCP_SALES_API_TOKEN=replace-with-another-distinct-server-only-token
MCP_SALES_ACTOR_ID=service:mcp-sales-order
MCP_SALES_WAREHOUSE_IDS=00000000-0000-4000-8000-000000000001
# Dedicated server-only token accepted only for Website AI usage writes.
WEBSITE_AI_API_TOKEN=replace-with-distinct-website-ai-server-token
WEBSITE_AI_ACTOR_ID=service:website-ai
# Customer Portal verifies external Clerk session JWTs through public JWKS. No Clerk secret is required here.
# When enabled, configure at least CUSTOMER_PORTAL_CLERK_AUDIENCE or CUSTOMER_PORTAL_CLERK_AUTHORIZED_PARTIES.
CUSTOMER_PORTAL_ENABLED=false
CUSTOMER_PORTAL_CLERK_ISSUER=https://REPLACE_WITH_CLERK_ISSUER
CUSTOMER_PORTAL_CLERK_JWKS_URL=https://REPLACE_WITH_CLERK_JWKS_URL
CUSTOMER_PORTAL_CLERK_AUDIENCE=
CUSTOMER_PORTAL_CLERK_AUTHORIZED_PARTIES=

# Phase 9.9 internal workforce authentication — server only.
# Owner email values and fixed test code are runtime secrets/config and must never be committed here.
INTERNAL_AUTH_ENABLED=false
INTERNAL_SESSION_TTL_SECONDS=28800
INTERNAL_WEB_OWNER_CHALLENGE_REQUIRED=true
ALLOW_FIXED_OWNER_CODE=false
SECURITY_OWNER_TEST_CODE=
SECURITY_OWNER_EMAILS=
IMPLEMENTATION_OWNER_EMAILS=

CORS_ORIGINS=http://127.0.0.1:3003

# Cloudflare R2 — backend only, disabled by default
R2_ENABLED=false
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<server-only-access-key-id>
R2_SECRET_ACCESS_KEY=<server-only-secret-access-key>
R2_PUBLIC_BASE_URL=
R2_PRESIGNED_URL_MAX_SECONDS=900
R2_MAX_OBJECT_BYTES=5242880
R2_CONTRACT_ROUTE_ENABLED=false
