# Kết nối Công Ty chỉ dùng phía server. Không đổi CORE_API_INTERNAL_URL thành biến NEXT_PUBLIC_*.
CORE_API_INTERNAL_URL=https://core.example.invalid

# App ID Web Push của Retail. App ID là định danh public; API key tuyệt đối không đặt ở frontend.
NEXT_PUBLIC_RETAIL_ONESIGNAL_APP_ID=replace-with-retail-onesignal-app-id
