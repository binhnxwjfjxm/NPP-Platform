NODE_ENV=production
SERVICE_NAME=mcp-plan-backend
HOST=127.0.0.1
PORT=3001
LEGACY_INTERNAL_PORT=3002

INSTALLATION_ID=replace_with_installation_id
NPP_CODE=replace_with_npp_code
MCP_LEGACY_ACTOR_ID=service:replace_with_npp_code:mcp-v1
AUTH_MODE=proxy-service
BACKEND_API_TOKEN=replace_with_at_least_32_random_characters

# Server-to-server Core customer verification boundary. Never expose these to the browser.
CORE_ONBOARDING_API_BASE_URL=https://core-api.example.com
CORE_ONBOARDING_API_TOKEN=replace_with_distinct_core_onboarding_token
CORE_ONBOARDING_TIMEOUT_MS=15000

# Server-to-server Core Sales boundary. Uses a distinct token and one reviewed warehouse.
CORE_SALES_API_BASE_URL=https://core-api.example.com
CORE_SALES_API_TOKEN=replace_with_distinct_core_sales_token
CORE_SALES_DEFAULT_WAREHOUSE_ID=00000000-0000-4000-8000-000000000001
CORE_SALES_TIMEOUT_MS=15000

# Empty lists are intentional and deny protected write commands by default.
# Grant only reviewed MCP permissions/scopes owned by this backend service.
MCP_SERVICE_ROLES=
MCP_SERVICE_PERMISSIONS=
MCP_SERVICE_SCOPES=

PERSISTENCE_PROVIDER=postgresql
DATABASE_URL=postgresql://mcp_runtime:replace_me@database.example.com:5432/installation
# MCP_MIGRATION_DATABASE_URL must not be stored in runtime app config.
MCP_DB_SCHEMA=mcp
MCP_DB_ROLE=mcp_runtime
MCP_DB_POOL_MAX=5
MCP_DB_CONNECT_TIMEOUT_MS=5000
MCP_DB_IDLE_TIMEOUT_MS=30000
MCP_DB_STATEMENT_TIMEOUT_MS=15000
MCP_LEGACY_RUNTIME_ENABLED=false

CORS_ORIGINS=https://app.example.com
UPSTREAM_TIMEOUT_MS=65000
