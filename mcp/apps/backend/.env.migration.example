# Operator-only environment. Do not persist these values in the MCP runtime app config.
NODE_ENV=production
DATABASE_URL=<operator-only-runtime-url>
MCP_MIGRATION_DATABASE_URL=<operator-only-migrator-url>
MCP_MIGRATION_ALLOW_PRODUCTION=false
MCP_MIGRATION_PRODUCTION_CONFIRM=

# Read-only target preflight confirmations. Keep false/empty until an approved window.
MCP_CUTOVER_PREFLIGHT_CONFIRM=
MCP_CUTOVER_PREFLIGHT_ALLOW_PRODUCTION=false
MCP_CUTOVER_PREFLIGHT_PRODUCTION_CONFIRM=
MCP_CUTOVER_EXPECTED_SOURCE_COMMIT=<40-character-commit>
MCP_DB_ROLE=mcp_runtime
