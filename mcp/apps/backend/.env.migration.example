# Operator-only environment. Do not persist database URLs in the MCP runtime app config.
NODE_ENV=production
DATABASE_URL=<operator-only-runtime-url>
MCP_MIGRATION_DATABASE_URL=<operator-only-migrator-url>

# Default mode keeps runtime and migrator credentials separated.
MCP_MIGRATION_CREDENTIAL_MODE=separated

# Heroku Postgres Essential fallback. Use only when the provider cannot issue a
# separate migrator credential. This mode must target the same host/port/database,
# use the same provider owner identity and will report leastPrivilege=false.
# MCP_MIGRATION_CREDENTIAL_MODE=essential_owner
MCP_MIGRATION_ESSENTIAL_OWNER_CONFIRM=

MCP_MIGRATION_ALLOW_PRODUCTION=false
MCP_MIGRATION_PRODUCTION_CONFIRM=

# Read-only target preflight confirmations. Keep false/empty until an approved window.
MCP_CUTOVER_PREFLIGHT_CONFIRM=
MCP_CUTOVER_PREFLIGHT_ALLOW_PRODUCTION=false
MCP_CUTOVER_PREFLIGHT_PRODUCTION_CONFIRM=
MCP_CUTOVER_EXPECTED_SOURCE_COMMIT=<40-character-commit>
MCP_DB_ROLE=mcp_runtime
