[Unit]
Description=MCP-Plan stale outlet media cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=MCP_BACKEND_ENV_FILE=@MCP_RUNTIME_DIR@/.env
ExecStart=@MCP_RUNTIME_DIR@/ops/run-outlet-media-cleanup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=@MCP_RUNTIME_DIR@
